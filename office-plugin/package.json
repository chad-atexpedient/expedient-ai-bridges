{
  "name": "expedient-ai-workspace",
  "version": "1.2.0",
  "private": true,
  "description": "Expedient AI Workspace add-in for Excel, Word, and PowerPoint with OpenAI/Anthropic-compatible providers and uploaded branding.",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host localhost --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "certs": "node tools/certs.mjs install",
    "certs:verify": "node tools/certs.mjs verify",
    "excel": "node tools/open-office.mjs excel",
    "word": "node tools/open-office.mjs word",
    "powerpoint": "node tools/open-office.mjs powerpoint",
    "stop": "node tools/stop-office.mjs",
    "serve": "node server/server.mjs",
    "manifest:prod": "node tools/make-production-manifest.mjs",
    "package:prod": "node node_modules/vite/bin/vite.js build && node tools/make-production-manifest.mjs && node scripts/package-release.mjs",
    "package:dev": "node node_modules/vite/bin/vite.js build && node scripts/package-release.mjs --dev",
    "smoke:prod": "node deploy/production/scripts/smoke-test.mjs",
    "smoke:ui": "node scripts/ui-smoke.mjs",
    "eval:self-test": "node evals/run.mjs --self-test",
    "eval:list": "node evals/run.mjs --list",
    "eval:validate": "node evals/run.mjs --validate",
    "eval:check-corpus": "node evals/run.mjs --check-corpus",
    "eval:seed": "node evals/run.mjs --seed-only",
    "security:release-gates": "node scripts/release-gates.mjs",
    "security:manifest": "node tools/make-production-manifest.mjs https://ai-workspace.expedient.example"
  },
  "dependencies": {
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.0.4",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "fast-xml-parser": "5.3.4",
    "jsdom": "27.2.0",
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.10",
    "playwright": "^1.62.0",
    "vitest": "4.1.10"
  }
}
