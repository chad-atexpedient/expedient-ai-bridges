OPENAI_BASE_URL=https://internal-beta.expedient.cloud/api/v1
BRIDGE_HOST=127.0.0.1
PORT=4001
ANTHROPIC_PORT=4002
LOG_LEVEL=info
OFFICE_WORKSPACE_BASE_URL=https://localhost:3000
# Internal pilot builds expose Office host diagnostics in the tray and app.
INTERNAL_DIAGNOSTICS=0
MAX_REQUEST_BODY_BYTES=10485760
MAX_RESPONSES_IN_FLIGHT=24
MAX_ANTHROPIC_IN_FLIGHT=24
ENABLE_INCREMENTAL_RESPONSES_STREAM=0
ENABLE_INCREMENTAL_ANTHROPIC_STREAM=0
UNSUPPORTED_TOOL_POLICY=reject

# Upstream API key (your LiteLLM/Expedient key)
# If set, the bridge uses this instead of the client's Authorization header
# This lets Codex use a dummy "sk-placeholder" key while the bridge uses your real key
UPSTREAM_API_KEY=

# Shared model slots. The desktop app can populate these from the upstream model catalog.
# Four recognized Codex aliases preserve the local agent tool profile.
MODEL_AGENT_FAST=gpt-5.6-luna
MODEL_AGENT_BALANCED=claude-sonnet-5
MODEL_AGENT_BALANCED_DEFAULT=claude-sonnet-5
MODEL_AGENT_POWER=claude-opus-5
MODEL_AGENT_GENERAL=gpt-5.6
# Direct custom aliases are intended for non-agent chat/background work.
MODEL_CHAT_FAST=gpt-5.6-luna
MODEL_CHAT_GENERAL=gpt-5.6-terra

# Image generation through an Open WebUI/OpenAI-compatible endpoint.
# Use the base through /v1, for example https://owui.example.com/api/v1.
IMAGE_GEN_MODEL=gpt-image-2
OWUI_IMAGE_BASE_URL=
OWUI_IMAGE_API_KEY=
